+                    original_claim = self.device._ctx.managed_claim_interface
+                    def claim_data_interface(device, interface):
+                        if interface == 0:
+                            return None
+                        return original_claim(device, interface)
+                    self.device._ctx.managed_claim_interface = claim_data_interface
             try:
                 if self.device.is_kernel_driver_active(0):
                     self.debug("Detaching kernel driver")
