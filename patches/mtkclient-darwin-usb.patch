         self.EP_OUT = None
         self.is_serial = False
         self.queue = Queue()
-        if sys.platform.startswith('freebsd') or sys.platform.startswith('linux') or sys.platform.startswith('darwin'):
+        if sys.platform.startswith('darwin'):
+            self.backend = usb.backend.libusb1.get_backend()
