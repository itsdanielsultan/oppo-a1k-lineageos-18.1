@@ -343,6 +345,17 @@ class UsbClass(DeviceClass):
 
         if self.interface != -1:
             itf = usb.util.find_descriptor(self.configuration, bInterfaceNumber=self.interface)
+            if sys.platform.startswith('darwin') and self.vid == 0x0E8D and self.pid == 0x0003 and self.interface == 1:
+                # macOS owns the CDC control interface; endpoint-zero requests do
+                # not need PyUSB to claim it. Keep normal claims for the data interface.
+                control_itf = usb.util.find_descriptor(self.configuration, bInterfaceNumber=0)
